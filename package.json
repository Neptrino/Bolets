{
  "name": "bolets-atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run media:build",
    "dev": "next dev --port 3101",
    "prebuild": "npm run media:build",
    "build": "next build",
    "start": "next start --port 3101",
    "lint": "eslint . && npm run source:size",
    "source:size": "node scripts/check-source-size.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "supabase:start": "supabase start --exclude realtime,imgproxy,postgres-meta,studio,logflare,vector,supavisor --yes",
    "supabase:reset": "supabase db reset --local --yes",
    "supabase:status": "supabase status",
    "test:terrain-live": "vitest run tests/terrain-thermal.live.test.ts --reporter=verbose --disableConsoleIntercept",
    "test:e2e": "playwright test",
    "worker:types": "npx --yes wrangler@4.125.0 types workers/open-meteo-relay/worker-configuration.d.ts --config workers/open-meteo-relay/wrangler.jsonc --env-file workers/open-meteo-relay/.dev.vars.example",
    "worker:check": "npm run worker:types && tsc -p workers/open-meteo-relay/tsconfig.json && npx --yes wrangler@4.125.0 deploy --dry-run --config workers/open-meteo-relay/wrangler.jsonc",
    "worker:deploy": "npx --yes wrangler@4.125.0 deploy --config workers/open-meteo-relay/wrangler.jsonc",
    "lambda:build": "npx --yes esbuild@0.28.2 lambda/open-meteo-relay/src/handler.ts --bundle --platform=node --format=cjs --target=node24 --outfile=lambda/open-meteo-relay/dist/index.js",
    "lambda:check": "tsc -p lambda/open-meteo-relay/tsconfig.json && npm run lambda:build",
    "pwa:icons": "node scripts/build-pwa-icons.mjs",
    "media:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/build-static-media.mts",
    "infographic:mushrooms": "node scripts/create-mushroom-infographic.mjs",
    "spatial:build": "node scripts/build-spatial-cells.mjs",
    "spatial:build-geology": "node scripts/build-spatial-geology.mjs",
    "spatial:update-geology-mapping": "node scripts/update-icgc-geology-mapping.mjs",
    "spatial:export-cell-ids": "node scripts/export-spatial-cell-ids.mjs",
    "spatial:import": "node scripts/import-spatial-cells.mjs",
    "spatial:precompute-habitat": "node scripts/precompute-coarse-habitat.mjs",
    "soil:fetch-clms": "node scripts/fetch-clms-soil.mjs",
    "soil:import-clms": "node scripts/import-clms-soil.mjs",
    "soil:sample-clms": "node --experimental-strip-types scripts/sample-clms-points.mts",
    "weather:compare-historical-findings": "node scripts/compare-historical-findings.mjs",
    "weather:compare-provider-shadows": "node scripts/compare-provider-shadows.mjs",
    "weather:compare-station-rain": "node --experimental-strip-types scripts/compare-station-rain.mts",
    "weather:backfill-xema-rain": "node scripts/backfill-xema-rain.mjs",
    "weather:compare-arome-artifacts": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/compare-arome-point-artifacts.mjs",
    "findings:convert": "node scripts/convert-findings-spreadsheet.mjs",
    "findings:fetch-fungacat": "node scripts/fetch-fungacat-events.mjs",
    "weather:evaluate-findings": "node scripts/evaluate-findings.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "bcryptjs": "3.0.3",
    "exifr": "7.1.3",
    "jose": "6.2.10",
    "lucide-react": "1.31.0",
    "maplibre-gl": "6.3.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tus-js-client": "4.3.1",
    "uplot": "^1.6.32",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "geotiff": "^3.0.5",
    "jsdom": "29.0.1",
    "proj4": "^2.21.0",
    "sharp": "^0.35.3",
    "supabase": "2.116.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
