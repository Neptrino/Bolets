[Unit]
Description=Publish the verified Bolets daily prediction to Instagram
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
ConditionPathExists=/opt/bolets/secrets/instagram.env

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
TimeoutStartSec=2m
ExecStart=/opt/bolets/app/deploy/vps/publish-instagram-daily.sh
