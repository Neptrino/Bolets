[Unit]
Description=Deliver queued Bolets contribution emails
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
ConditionPathExists=/opt/bolets/secrets/contribution-email.env

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
TimeoutStartSec=2m
ExecStart=/opt/bolets/app/deploy/vps/dispatch-contribution-emails.sh
