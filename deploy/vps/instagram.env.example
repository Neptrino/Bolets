# Copy to /opt/bolets/secrets/instagram.env, chmod 600, and replace every
# placeholder. Connect the Instagram Professional account directly in Buffer.
INSTAGRAM_PROFILE_URL=https://www.instagram.com/bolets.app/
BUFFER_API_KEY=replace-with-the-buffer-api-key
BUFFER_INSTAGRAM_CHANNEL=bolets.app
INSTAGRAM_PUBLISH_SECRET=replace-with-openssl-rand-hex-32
