    {
      "id": 14,
      "title": "Collection and runtime sample age",
      "type": "timeseries",
      "description": "Metrics are scraped every 60 seconds. Sustained gaps above a few minutes warrant checking Alloy and application health.",
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
