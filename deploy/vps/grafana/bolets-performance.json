{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Bolets metrics",
      "description": "Select the Prometheus source receiving Alloy metrics.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "DS_LOKI",
      "label": "Bolets logs",
      "description": "Select the Loki source receiving Docker logs.",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "uid": "bolets-performance",
  "title": "Bolets performance",
  "description": "Public response latency, Node.js stalls, resource usage and telemetry health. Built from the deployed Bolets Alloy and Caddy instrumentation.",
  "tags": [
    "bolets",
    "performance"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "route",
        "label": "Public route",
        "type": "custom",
        "query": "home,current,map,map-data,species,territory,field-card,static",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "home",
            "value": "home",
            "selected": false
          },
          {
            "text": "current",
            "value": "current",
            "selected": false
          },
          {
            "text": "map",
            "value": "map",
            "selected": false
          },
          {
            "text": "map-data",
            "value": "map-data",
            "selected": false
          },
          {
            "text": "species",
            "value": "species",
            "selected": false
          },
          {
            "text": "territory",
            "value": "territory",
            "selected": false
          },
          {
            "text": "field-card",
            "value": "field-card",
            "selected": false
          },
          {
            "text": "static",
            "value": "static",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Origin performance \u00b7 how to read",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**These charts measure origin traffic.** Since 5 September 2026, Cloudflare cache hits do not reach the VPS and are absent from request counts and timings. Proxy response time includes transfer from Caddy to Cloudflare; application first-byte time measures the upstream wait. Use Cloudflare Cache Analytics for edge hits and overall edge traffic. Metrics refresh each minute; response charts use five-minute windows. Timing logs cover allowlisted public routes and exclude private contexts and Do Not Track. No samples means no matching observations, not zero latency. Cold card rendering can take about 3 seconds."
      }
    },
    {
      "id": 2,
      "title": "Runtime collection",
      "type": "stat",
      "description": "1 means the latest scrape succeeded; no samples is unknown, not healthy.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"bolets-runtime\",instance=\"bolets-vps-1\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "Scrape",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Longest server stall \u00b7 latest minute",
      "type": "stat",
      "description": "The longest measured event-loop delay in the latest completed minute. Investigate repeated values over 200 ms.",
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bolets_event_loop_delay_max_seconds{job=\"bolets-runtime\",instance=\"bolets-vps-1\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "Delay",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "App resident memory",
      "type": "stat",
      "description": "Resident process memory includes heap, native memory and image buffers.",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bolets_process_resident_memory_bytes{job=\"bolets-runtime\",instance=\"bolets-vps-1\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "RSS",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "Host CPU busy",
      "type": "stat",
      "description": "",
      "gridPos": {
        "x": 18,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - avg(rate(node_cpu_seconds_total{job=\"bolets-host\",instance=\"bolets-vps-1\",mode=\"idle\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "CPU",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 6,
      "title": "Proxy response time \u00b7 p95 by route",
      "type": "timeseries",
      "description": "95th percentile of logged proxy durations over five minutes. Includes transfer to the client; not browser page-load time.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, {job=\"bolets-docker\",host=\"bolets-vps-1\"} | json | __error__=\"\" | route_group=~\"${route:regex}\" | route_group!=\"\" | unwrap duration | __error__=\"\" [5m]) by (route_group)",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "legendFormat": "{{route_group}}",
          "editorMode": "code",
          "range": true,
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 7,
      "title": "Application first-byte time \u00b7 p95 by route",
      "type": "timeseries",
      "description": "Time waiting for upstream application headers. Direct static responses have no upstream and are excluded.",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, {job=\"bolets-docker\",host=\"bolets-vps-1\"} | json | __error__=\"\" | route_group=~\"${route:regex}\" | route_group!=\"\" | unwrap upstream_latency_ms | __error__=\"\" [5m]) by (route_group)",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "legendFormat": "{{route_group}}",
          "editorMode": "code",
          "range": true,
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 8,
      "title": "Measured public requests per minute",
      "type": "timeseries",
      "description": "Five-minute average. This is the measured public subset, not all site traffic.",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route_group) (rate({job=\"bolets-docker\",host=\"bolets-vps-1\"} | json | __error__=\"\" | route_group=~\"${route:regex}\" | route_group!=\"\" [5m])) * 60",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "legendFormat": "{{route_group}}",
          "editorMode": "code",
          "range": true,
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 9,
      "title": "HTTP 5xx responses \u00b7 five-minute count",
      "type": "timeseries",
      "description": "Empty means no matching logged errors in the selected interval; use collection health to distinguish missing telemetry.",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route_group) (count_over_time({job=\"bolets-docker\",host=\"bolets-vps-1\"} | json | __error__=\"\" | route_group=~\"${route:regex}\" | route_group!=\"\" | status >= 500 | __error__=\"\" [5m]))",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "legendFormat": "{{route_group}}",
          "editorMode": "code",
          "range": true,
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 10,
      "title": "Event-loop delay \u00b7 completed minute windows",
      "type": "timeseries",
      "description": "A 20 ms sampling interval creates an idle baseline near 20 ms. Large spikes indicate the Node.js process could not promptly run callbacks.",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bolets_event_loop_delay_p99_seconds{job=\"bolets-runtime\",instance=\"bolets-vps-1\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "p99",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "B",
          "expr": "bolets_event_loop_delay_max_seconds{job=\"bolets-runtime\",instance=\"bolets-vps-1\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "Maximum",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 11,
      "title": "Event-loop utilization",
      "type": "timeseries",
      "description": "Fraction of each minute the Node.js event loop was active. This differs from total host CPU.",
