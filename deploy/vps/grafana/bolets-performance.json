    {
      "id": 13,
      "title": "Host memory available",
      "type": "timeseries",
      "description": "Available host memory includes reclaimable memory.",
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemAvailable_bytes{job=\"bolets-host\",instance=\"bolets-vps-1\"} / node_memory_MemTotal_bytes{job=\"bolets-host\",instance=\"bolets-vps-1\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
