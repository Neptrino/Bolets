logging {
  level  = "info"
  format = "logfmt"
}

prometheus.exporter.unix "host" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  set_collectors = [
    "cpu",
    "loadavg",
    "meminfo",
    "netdev",
    "stat",
    "time",
    "uname",
    "vmstat",
  ]
}

prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.host.receiver]
}

prometheus.relabel "host" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]

  rule {
    target_label = "instance"
    replacement  = sys.env("BOLETS_OBSERVABILITY_INSTANCE")
  }

  rule {
    target_label = "job"
    replacement  = "bolets-host"
  }
}

prometheus.scrape "bolets_operations" {
  targets = [{
    "__address__" = "app:3000",
    "instance"    = sys.env("BOLETS_OBSERVABILITY_INSTANCE"),
    "job"         = "bolets-operations",
  }]
  metrics_path    = "/api/internal/metrics"
  scrape_interval = "60s"
  scrape_timeout  = "15s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]

  authorization {
    type        = "Bearer"
    credentials = sys.env("STATUS_INTERNAL_TOKEN")
  }
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_PROMETHEUS_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_PROMETHEUS_USERNAME")
      password = sys.env("GRAFANA_CLOUD_API_TOKEN")
    }
  }
}

loki.source.file "docker" {
  targets = [{
    "__path__" = "/var/lib/docker/containers/*/*-json.log",
    "host"     = sys.env("BOLETS_OBSERVABILITY_INSTANCE"),
    "job"      = "bolets-docker",
  }]
  forward_to             = [loki.process.docker.receiver]
  tail_from_end          = true
  on_positions_file_error = "restart_from_end"

  file_match {
    enabled           = true
    ignore_older_than = "24h"
    sync_period       = "10s"
  }
}

loki.process "docker" {
  forward_to = [loki.write.grafana_cloud.receiver]

  stage.regex {
    source             = "filename"
    expression         = "/var/lib/docker/containers/(?P<container_id>[a-f0-9]{12})[a-f0-9]*/.*"
    labels_from_groups = true
  }

  stage.docker {}
}

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_LOKI_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_LOKI_USERNAME")
      password = sys.env("GRAFANA_CLOUD_API_TOKEN")
    }
  }
}
