{
	email {$TLS_EMAIL}
	admin off
	# Only Cloudflare edges may assert a client address, so client addressing is
	# correct whether the apex is DNS-only (the normal state) or proxied during
	# an attack. Ranges: https://www.cloudflare.com/ips/ (checked 2026-09-19).
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
	# Error logs must not retain request URLs, credentials or client identities.
	log default {
		format filter {
			request delete
			resp_headers delete
			wrap json
		}
	}
}

{$APP_DOMAIN}, www.{$APP_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Only fixed public route groups are recorded. No raw path, query, header,
	# IP, referrer or response header survives the encoder.
	map {path} {bolets_route_group} {
		~^/media/optimized/ static
		~^/_next/static/ static
		~^/icons/ static
		~^/bolets/[^/]+/targeta$ field-card
		~^/bolets(/[^/]+)?$ species
		~^/zones(/[^/]+){0,3}$ territory
		~^/map(/[^/]+)?$ map
		/bolets-avui current
		/api/predictions map-data
		/ home
		default excluded
	}
	log public_timing {
		output stdout
		format filter {
			request delete
			resp_headers delete
			user_id delete
			wrap json
		}
	}
	@excluded_timing expression `{bolets_route_group} == "excluded" || !({http.request.method} in ["GET", "HEAD"]) || {http.request.header.DNT} == "1"`
	log_skip @excluded_timing
	@private_referrer header_regexp Referer ^https?://[^/]+/(admin|acces|compte|moderacio|troballes/nova)(/|\?|$)
	log_skip @private_referrer
	@private_map_timing {
		path /api/predictions
		not query resolution=2500 resolution=5000 resolution=10000
	}
	log_skip @private_map_timing
	log_append route_group {bolets_route_group}
	log_append upstream_duration_ms {rp.upstream.duration_ms}
	log_append upstream_latency_ms {rp.upstream.latency_ms}

	@immutable_assets path /media/optimized/* /_next/static/*
	handle @immutable_assets {
		root * /srv/bolets-static
		header Cache-Control "public, max-age=31536000, immutable" {
			match status 200 206 304
		}
		# Brotli sidecars are written by scripts/export-static-assets.mjs; any
		# other encoding comes from encode above.
		file_server {
			precompressed br
		}
	}
	@icons path /icons/*
	handle @icons {
		root * /srv/bolets-static
		header Cache-Control "public, max-age=3600" {
			match status 200 206 304
		}
		file_server
	}

	@admin path /admin /admin/*
	handle @admin {
		header {
			Cache-Control "private, no-store"
			X-Robots-Tag "noindex, nofollow, noarchive"
		}
		reverse_proxy app:3000 {
			# Never trust a client-supplied copy of the private metrics header.
			header_up -X-Bolets-Status-Auth
			# The application reads X-Real-IP only; it is always Caddy's verdict.
			header_up X-Real-IP {client_ip}
			header_up -CF-Connecting-IP
		}
	}

	@internal_api path /api/internal/*
	handle @internal_api {
		respond "Not found" 404
	}

	handle {
		reverse_proxy app:3000 {
			# Never trust a client-supplied copy of the private ingress header.
			header_up -X-Bolets-Status-Auth
			header_up X-Real-IP {client_ip}
			header_up -CF-Connecting-IP
		}
	}
}

{$API_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@public_api path \
 /functions/v1* \
 /auth/v1* \
 /rest/v1* \
 /storage/v1*

	handle @public_api {
		reverse_proxy api-gw:8000
	}

	handle {
		respond "Not found" 404
	}
}

{$ANALYTICS_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy umami:3000
}
