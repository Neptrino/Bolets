{
	email {$TLS_EMAIL}
	admin off
}

{$APP_DOMAIN}, www.{$APP_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@admin path /admin /admin/*
	handle @admin {
		header {
			Cache-Control "private, no-store"
			X-Robots-Tag "noindex, nofollow, noarchive"
		}
		reverse_proxy app:3000 {
			# Never trust a client-supplied copy of the private metrics header.
			header_up -X-Bolets-Status-Auth
		}
	}

	@internal_api path /api/internal/*
	handle @internal_api {
		respond "Not found" 404
	}

	handle {
		reverse_proxy app:3000 {
			# Never trust a client-supplied copy of the private ingress header.
			header_up -X-Bolets-Status-Auth
		}
	}
}

{$API_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@public_api path \
 /functions/v1* \
 /auth/v1* \
 /rest/v1* \
 /storage/v1*

	handle @public_api {
		reverse_proxy api-gw:8000
	}

	handle {
		respond "Not found" 404
	}
}

{$ANALYTICS_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy umami:3000
}
