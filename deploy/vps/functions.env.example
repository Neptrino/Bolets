# Copy to /opt/bolets/secrets/functions.env, chmod 600, and populate only the
# provider secrets needed by deployed Edge Functions. Supabase credentials are
# already injected by the upstream functions service.
METEOFRANCE_AROME_API_KEY=

# Authenticated single-purpose Cloudflare Worker egress for Open-Meteo. Use
# the exact /v1/fetch URL printed by Wrangler and the same random secret that
# was installed with `wrangler secret put RELAY_HMAC_SECRET`.
OPEN_METEO_CF_RELAY_URL=https://bolets-open-meteo-relay.<workers-subdomain>.workers.dev/v1/fetch
OPEN_METEO_RELAY_HMAC_SECRET=replace-with-openssl-rand-hex-32

# Independent AWS Lambda Function URL relay. Its HMAC secret is deliberately
# distinct from the Cloudflare relay secret.
OPEN_METEO_AWS_RELAY_URL=https://replace-me.lambda-url.eu-south-2.on.aws/v1/fetch
OPEN_METEO_AWS_RELAY_HMAC_SECRET=replace-with-a-different-openssl-rand-hex-32
