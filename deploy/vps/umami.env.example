# Copy to /opt/bolets/secrets/umami.env, replace every placeholder and chmod
# the file to 600. rollout.sh sources this root-controlled file before Compose.
ANALYTICS_DOMAIN=analytics.bolets.app
UMAMI_HTTP_PORT=3001
UMAMI_WEBSITE_ID=ce97249f-b2de-44bd-899c-56f8fc05cb54

# Generate each value independently with `openssl rand -hex 32`.
UMAMI_DATABASE_PASSWORD=replace-with-a-random-value
UMAMI_APP_SECRET=replace-with-a-random-value
UMAMI_TWO_FACTOR_ENCRYPTION_KEY=replace-with-a-64-character-hex-value
UMAMI_ADMIN_PASSWORD=replace-with-a-strong-login-password
