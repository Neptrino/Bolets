[Unit]
Description=Back up the Bolets self-hosted Supabase database and Storage
Requires=docker.service
After=docker.service
ConditionPathExists=/opt/bolets/supabase/docker-compose.yml

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=2h
ExecStart=/opt/bolets/app/deploy/vps/backup.sh /opt/bolets/supabase /var/backups/bolets

