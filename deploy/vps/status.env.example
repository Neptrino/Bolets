# Store the populated copy at /opt/bolets/secrets/status.env with mode 0600.
# STATUS_PASSWORD_HASH must be a bcrypt hash, not plaintext:
# docker run --rm caddy:2.10.2-alpine caddy hash-password --plaintext 'PASSWORD'
STATUS_USERNAME=bolets-ops
STATUS_PASSWORD_HASH='$2a$14$replace_with_a_caddy_hash'
STATUS_INTERNAL_TOKEN=replace_with_openssl_rand_hex_32
STATUS_SESSION_SECRET=replace_with_openssl_rand_base64_32
