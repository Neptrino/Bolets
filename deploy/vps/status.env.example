# Store the populated copy at /opt/bolets/secrets/status.env with mode 0600.
# Interactive admin access uses the normal Supabase Auth session plus the
# server-managed app_metadata role. This token is only for internal metrics.
STATUS_INTERNAL_TOKEN=replace_with_openssl_rand_hex_32
# Signs the five-minute, HTTP-only capability used by detailed map routes.
# Keep it distinct from the status token and Supabase keys.
CONTRIBUTOR_ACCESS_SECRET=replace_with_a_second_openssl_rand_hex_32
