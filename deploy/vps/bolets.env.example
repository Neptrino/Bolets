# Add these values to the official Supabase deployment's .env file after its
# key-generation scripts have replaced every upstream placeholder.
BOLETS_APP_DIR=/opt/bolets/app
BOLETS_FUNCTIONS_ENV_FILE=/opt/bolets/secrets/functions.env
BOLETS_UMAMI_ENV_FILE=/opt/bolets/secrets/umami.env
BOLETS_INSTAGRAM_ENV_FILE=/opt/bolets/secrets/instagram.env
BOLETS_CONTRIBUTION_EMAIL_ENV_FILE=/opt/bolets/secrets/contribution-email.env
BOLETS_BACKLINK_ENV_FILE=/opt/bolets/secrets/backlink.env

APP_DOMAIN=bolets.app
API_DOMAIN=api.bolets.app
TLS_EMAIL=admin@example.com

# Public gateway and Auth URLs used by the Supabase services.
SUPABASE_PUBLIC_URL=https://api.bolets.app
API_EXTERNAL_URL=https://api.bolets.app/auth/v1
SITE_URL=https://bolets.app
ADDITIONAL_REDIRECT_URLS=https://www.bolets.app,https://bolets.app/auth/callback,https://www.bolets.app/auth/callback
# Optional HTTPS contribution page rendered in the public footer.
SUPPORT_URL=

# Google is shown only after valid OAuth credentials are configured. In Google
# Cloud, authorize https://api.bolets.app/auth/v1/callback as the redirect URI.
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# Passkeys are bound to this relying-party ID. Do not change it after users
# enroll credentials or those credentials will stop working.
PASSKEY_ENABLED=true
PASSKEY_RP_DISPLAY_NAME=Bolets Atles
PASSKEY_RP_ID=bolets.app
PASSKEY_RP_ORIGINS=https://bolets.app,https://www.bolets.app

# Keep direct service ports on their loopback defaults.
API_GW_HTTP_PORT=8000
POSTGRES_PORT=5432
POOLER_PROXY_PORT_TRANSACTION=6543

# Passwordless email accounts back the private field notebook. Phone and
# anonymous sign-in remain disabled.
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_PHONE_SIGNUP=false
MAILER_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=bolets@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASS=replace-me
SMTP_SENDER_NAME=Bolets Atles
MAILER_TEMPLATES_MAGIC_LINK=https://bolets.app/email-templates/magic-link.html

# Avoid the optional analytics containers on an 8 GB VPS initially.
COMPOSE_FILE=docker-compose.yml
