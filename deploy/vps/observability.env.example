# Create a Grafana Cloud access policy token with MetricsPublisher and
# LogsPublisher scopes. Store the populated file at
# /opt/bolets/secrets/observability.env with mode 0600.
GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-prod-xx.grafana.net/api/prom/push
GRAFANA_CLOUD_PROMETHEUS_USERNAME=replace_with_metrics_instance_id
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-xxx.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USERNAME=replace_with_logs_instance_id
GRAFANA_CLOUD_API_TOKEN=replace_with_access_policy_token
BOLETS_OBSERVABILITY_INSTANCE=bolets-vps-1
