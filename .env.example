SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
INSTAGRAM_PROFILE_URL=https://www.instagram.com/bolets.app/
# Optional HTTPS contribution page (Buy Me a Coffee, Ko-fi, PayPal, etc.).
# When unset, the support action is omitted from the public footer.
SUPPORT_URL=
BUFFER_API_KEY=
BUFFER_INSTAGRAM_CHANNEL=bolets.app
INSTAGRAM_PUBLISH_SECRET=
# Read by the Supabase CLI from the repository-root .env file. Keep the real
# Google OAuth secret out of version control.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
# Browser-safe Auth and resumable Storage endpoint. In local development this
# is normally http://127.0.0.1:54321; production uses https://api.bolets.app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cloudflare Turnstile protects first and suspicious public-finding attempts.
# The site key is browser-safe; the secret and hostname allowlist are server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=bolets.app,www.bolets.app
# Optional independent HMAC key for network rate-limit subjects. When omitted,
# the server-side Supabase service key is used; raw addresses are never stored.
ABUSE_RATE_LIMIT_SECRET=
# Optional local-development-only origin for public map reads. This never
# forwards credentials and is ignored outside `next dev`.
BOLETS_DEV_PUBLIC_DATA_ORIGIN=
# Alternatively, run local scoring against a public environmental feed. Unset
# BOLETS_DEV_PUBLIC_DATA_ORIGIN when using these. Only 2.5 km+ spatial GETs use
# this anonymous credential; authentication and administration stay local.
BOLETS_DEV_SPATIAL_DATA_URL=
BOLETS_DEV_SPATIAL_ANON_KEY=
# Optional server-only credential for authorized 1 km/250 m environmental GETs
# from that same origin. Without it, detailed reads use the local database.
# Never use NEXT_PUBLIC_ or commit a credential; local login is still required.
BOLETS_DEV_SPATIAL_SERVICE_ROLE_KEY=
# Optional public Cloudflare R2/custom-CDN base URL for immutable habitat JSON.
# Missing objects automatically fall back to the Supabase reader.
HABITAT_ASSET_BASE_URL=
