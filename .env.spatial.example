# Trusted offline/CI importer only. Never expose these values to browser code.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SPATIAL_IMPORT_TOKEN=
# Or keep the token in a temporary secret file instead:
# SPATIAL_IMPORT_TOKEN_FILE=/absolute/path/to/spatial-import-token

# Optional alternative for controlled CI only; do not place this in .env.local.
# SUPABASE_SERVICE_ROLE_KEY=
